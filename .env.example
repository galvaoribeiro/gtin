# JWT (sessão do painel)
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Token estático para GET /api/admin/signups (assistente/automação somente leitura).
# Sem este valor o endpoint responde 503. Gere com: openssl rand -hex 32
ADMIN_READONLY_TOKEN=

# Banco e cache
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/gtindata
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# App
ENVIRONMENT=development
FRONTEND_BASE_URL=http://localhost:3000
